APP_NAME="Stock Card System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stock_card
DB_USERNAME=stock_card
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when the app is served over HTTPS (production).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Emails are queued. "sync" sends them immediately (simplest); with "database",
# keep "php artisan queue:work" running so queued emails are delivered.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes emails to storage/logs/laravel.log instead of sending them.
# To deliver real email, use SMTP, e.g. Gmail: MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com,
# MAIL_PORT=587, MAIL_SCHEME=null, MAIL_USERNAME=your Gmail address, MAIL_PASSWORD=a Google App Password.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="stockcard@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Development only. Password for the demo accounts created by "php artisan db:seed".
# Leave empty to have the seeder generate and print a random password.
# Demo data is never seeded when APP_ENV=production.
DEMO_USER_PASSWORD=

# Weekday time (HH:MM) for the low-stock summary email. Requires the scheduler: php artisan schedule:work
LOW_STOCK_DIGEST_TIME=08:00
