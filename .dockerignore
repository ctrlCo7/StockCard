# Secrets and local-only files never go into the image.
.env
.env.*
!.env.example
.git
.claude
.ai
.mcp.json
boost.json
*.bat

# Rebuilt inside the image or provided at runtime.
vendor
node_modules
bootstrap/cache/*.php

# Data lives in Docker volumes / the mounted storage folder, not in the image.
database/*.sqlite*
storage/app/*
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing

# Development-only.
tests
phpunit.xml
